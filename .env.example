# =============================================================================
# Polymarket Trading Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Alternatively, you can add accounts directly through the UI (Live Mode > Accounts).
#
# NOTE: Private keys stored here are used as the default/fallback account.
# For multi-account support, use the in-app Account Manager.
# =============================================================================


# --- Primary Trading Account (Optional if using in-app Account Manager) ------

# Your Ethereum/Polygon wallet private key (0x-prefixed)
# This wallet must have MATIC for gas and USDC for trading
POLYMARKET_PRIVATE_KEY=0x...

# Your wallet's public address (auto-derived if not set)
# POLYMARKET_WALLET_ADDRESS=0x...


# --- Polymarket CLOB API Keys (Optional — auto-derived from private key) ------
# If not provided, the system will automatically derive these on first run.
# You can get them from https://polymarket.com (Account > API Keys)

# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=


# --- App Settings ---------------------------------------------------------------

# Set to "production" for live deployment
NODE_ENV=development

# Next.js public URL (used for internal API calls in server components)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
