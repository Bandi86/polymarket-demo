{
  "name": "btc-trading-simulator",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "build:css": "bunx tailwindcss -i ./src/styles/globals.css -o ./src/styles/generated.css --content './src/**/*.tsx'",
    "build": "bun run build:css && bun build ./src/index.html --outdir ./dist --target=browser",
    "dev": "bun run build && bun --hot src/server.ts",
    "start": "bun run build && bun src/server.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.35.2",
    "lucide-react": "^0.576.0",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^28.1.0",
    "vitest": "^3.0.0"
  }
}
